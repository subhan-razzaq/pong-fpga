localparam ACTIVE_COLUMNS = 640;
localparam ACTIVE_ROWS = 480;
localparam FRONT_PORCH_H = 16;
localparam BACK_PORCH_H = 48;
localparam SYNCPULSE_H = 96;
localparam FRONT_PORCH_V = 10;
localparam BACK_PORCH_V = 33;
localparam SYNCPULSE_V = 2;
localparam TILE_COLUMN = 40;
localparam TILE_ROW = 30;
localparam TILE_SIZE = 16;
localparam SYNC_START_H = ACTIVE_COLUMNS + FRONT_PORCH_H;
localparam SYNC_STOP_H = SYNC_START_H + SYNCPULSE_H;
localparam SYNC_START_V = ACTIVE_ROWS + FRONT_PORCH_V;
localparam SYNC_STOP_V = SYNC_START_V + SYNCPULSE_V;
localparam TOTAL_COLUMNS = ACTIVE_COLUMNS + FRONT_PORCH_H + BACK_PORCH_H + SYNCPULSE_H;
localparam TOTAL_ROWS = ACTIVE_ROWS + FRONT_PORCH_V + BACK_PORCH_V + SYNCPULSE_V;